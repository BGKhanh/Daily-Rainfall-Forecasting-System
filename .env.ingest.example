# DS108 Scheduled Batch Ingest & MLOps Environment Template (GitHub Actions / Cron Runner)
# Populate as GitHub Actions Repository Secrets or local `.env.ingest`. NEVER commit real tokens.

STORE_BACKEND=turso_remote
TURSO_DB_URL=libsql://your-db-your-org.turso.io
# IMPORTANT: Batch ingest & forecast ledger issuance require a Turso Read-Write token
TURSO_AUTH_TOKEN=
TURSO_API_TOKEN=

# DagsHub MLflow Model Registry (dev/CI verification only; never bundled in serving image)
MLFLOW_TRACKING_URI=https://dagshub.com/BGKhanh/Daily-Rainfall-Forecasting-System.mlflow
MLFLOW_TRACKING_USERNAME=BGKhanh
MLFLOW_TRACKING_PASSWORD=

# Optional cache-refresh webhook invoked after scheduled ingest (`automated_pipeline.py refresh-cache`)
CACHE_REFRESH_WEBHOOK_URL=
