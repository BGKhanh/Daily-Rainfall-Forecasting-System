# DS108 Frontend SPA Build Environment Template (Cloudflare Workers Assets + Vite)
# Copy to `frontend/.env.local` for local preview builds, or set in Cloudflare Workers Build Variables.
# NEVER place Turso/DagsHub secrets in `VITE_*` variables (they are embedded in public browser bundles).

# Required for production Cloudflare Workers builds (API origin with HTTPS scheme, no trailing slash)
VITE_API_BASE_URL=https://api.your-domain.example

# Cold-start banner threshold in milliseconds (Render/EC2 wake indicator)
VITE_COLD_START_THRESHOLD_MS=3000

# Public external links shown in top header & About modal
VITE_REPO_URL=https://github.com/BGKhanh/Daily-Rainfall-Forecasting-System
VITE_CI_URL=https://github.com/BGKhanh/Daily-Rainfall-Forecasting-System/actions
VITE_MLFLOW_URL=https://dagshub.com/BGKhanh/Daily-Rainfall-Forecasting-System.mlflow
