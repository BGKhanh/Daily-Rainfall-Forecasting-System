# DS108 HCMC Rainfall Forecasting — Environment Variables Template (Layer 1)
# Copy this file to `.env` for local development. Never commit `.env` with real tokens.

# Store backend mode: local | turso_replica | turso_remote
STORE_BACKEND=local

# Optional local SQLite override or replica file path
VINTAGE_DB_PATH=data/vintage/rainfall_vintage.db
TURSO_REPLICA_PATH=data/vintage/turso_replica.db

# Turso Platform & Database Credentials (required only for turso_replica / turso_remote)
TURSO_API_TOKEN=
TURSO_DB_URL=libsql://your-db-your-org.turso.io
TURSO_DB_TOKEN=
TURSO_READONLY_AUTH_TOKEN=

# Optional webhook notified by `scripts/mlops/automated_pipeline.py refresh-cache`
CACHE_REFRESH_WEBHOOK_URL=
