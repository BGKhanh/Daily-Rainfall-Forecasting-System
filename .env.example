# DS108 HCMC Rainfall Forecasting — Unified Local Development Environment Template (Layer 1)
# Copy this file to `.env` for local development. Never commit `.env` or real tokens.
#
# For decoupled production deployments, see the role-scoped templates:
#   - `.env.serving.example`   (AWS EC2 read-only API container)
#   - `.env.ingest.example`    (GitHub Actions / batch NASA POWER ingest + MLOps)
#   - `frontend/.env.example`  (Cloudflare Workers SPA static build)
# Full inventory & fail-fast contract: `docs/ENV_CONTRACT.md`

# Runtime profile: development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# ENABLE_API_DOCS=true
SERVE_STATIC_SPA=false

# Store backend mode: local | turso_replica | turso_remote
STORE_BACKEND=local

# Optional local SQLite override or Turso replica file path
VINTAGE_DB_PATH=data/vintage/rainfall_vintage.db
TURSO_REPLICA_PATH=data/vintage/turso_replica.db
TURSO_SYNC_INTERVAL_SEC=300

# Local dev Vite CORS origins (appended to config/runtime_config.toml dev list)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Turso Platform & Database Credentials (required only for turso_replica / turso_remote)
TURSO_API_TOKEN=
TURSO_DB_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
TURSO_DB_TOKEN=
TURSO_READONLY_AUTH_TOKEN=

# Optional webhook notified by `scripts/mlops/automated_pipeline.py refresh-cache`
CACHE_REFRESH_WEBHOOK_URL=
