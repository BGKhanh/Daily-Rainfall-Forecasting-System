{
  "openapi": "3.1.0",
  "info": {
    "title": "HCMC Daily Rainfall Forecasting Serving Engine",
    "description": "Operational API for 7-day multi-horizon daily rainfall forecasting locked to HCMC with locked OpenAPI schemas, Two-DB SQLite DDL V3.2 governance, and shadow model telemetry.",
    "version": "1.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Get Health",
        "description": "Health check endpoint reporting model readiness, active Two-DB role, anchor range, and group latency.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "tags": [
          "Governance"
        ],
        "summary": "Get Model Metadata",
        "description": "Returns governance metadata, hyperparameters, baselines, and cryptographic SHA-256 hashes.",
        "operationId": "get_model_metadata_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          },
          "503": {
            "description": "Predictor not initialized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Forecasting"
        ],
        "summary": "Predict Rainfall",
        "description": "Generate 7-day multi-horizon rainfall predictions after `anchor_date` for Ho Chi Minh City (`HCMC`).",
        "operationId": "predict_rainfall_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request — Client-supplied `request.history` payload violates business or physical rules (<30 continuous days, calendar date gap, NaN/-999.0 sentinel, physical bound violation, or invalid/stale run_date).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity — Invalid JSON/Pydantic schema types, unsupported `location_id`/`province` outside Ho Chi Minh City, OR `anchor_date` missing/violating `COMPLETE_ALL_35` radiation completeness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable — Predictor not initialized, OR server-side DB/history provider failed or returned incomplete/NaN meteorological records when `request.history` is omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/scores": {
      "get": {
        "tags": [
          "Governance"
        ],
        "summary": "Get Scores",
        "description": "Query `v_forecast_scores` from active SQLite Vintage Store and return per-model overall & horizon\nscores (MAE, MSE, RMSE, MASE), Moving Block Bootstrap 95% CIs (`block_length = 7`), sample sizes,\npairwise ML differences, and mandatory methodological notes.",
        "operationId": "get_scores_scores_get",
        "parameters": [
          {
            "name": "eval_split_regime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Canonical split regime filter ('DEV_TRAIN', 'VALIDATION', 'TEST', 'POST_TEST').",
              "default": "POST_TEST",
              "title": "Eval Split Regime"
            },
            "description": "Canonical split regime filter ('DEV_TRAIN', 'VALIDATION', 'TEST', 'POST_TEST')."
          },
          {
            "name": "is_prospective",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional filter: 1 for strictly prospective forecasts, 0 for retrospective, or omit for all.",
              "title": "Is Prospective"
            },
            "description": "Optional filter: 1 for strictly prospective forecasts, 0 for retrospective, or omit for all."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoresResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity — Invalid `eval_split_regime` or `is_prospective` query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable — SQLite vintage database unavailable or corrupted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/benchmark/leaderboard": {
      "get": {
        "tags": [
          "Governance"
        ],
        "summary": "Get Leaderboard",
        "description": "Returns top audited benchmark scenarios from official benchmark test leaderboards.",
        "operationId": "get_leaderboard_benchmark_leaderboard_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 72,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid limit parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Benchmark leaderboard artifact unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
