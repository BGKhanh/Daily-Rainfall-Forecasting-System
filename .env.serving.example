# DS108 Backend Serving Production Environment Template (AWS EC2 + Docker + Turso Read-Only Replica)
# Copy to `.env.serving` on the EC2 host (`chmod 600 .env.serving`). NEVER commit `.env.serving`.

# Domain used by Caddy reverse proxy (`deploy/ec2/Caddyfile.example`)
BACKEND_DOMAIN=api.your-domain.example

# Strict production profile (disables /docs, /redoc, /openapi.json and enforces Turso + CORS validation)
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
SERVE_STATIC_SPA=false

# Embedded read-only SQLite replica synchronized from Turso Primary
STORE_BACKEND=turso_replica
TURSO_DB_URL=libsql://your-db-your-org.turso.io
# IMPORTANT: Supply ONLY a Turso Read-Only token created via:
#   turso db tokens create <db_name> --read-only
TURSO_AUTH_TOKEN=
TURSO_REPLICA_PATH=/var/lib/rainfall/replica.db
TURSO_SYNC_INTERVAL_SEC=300

# Comma-separated non-localhost HTTPS origins allowed to query the API (Cloudflare Workers frontend)
CORS_ALLOWED_ORIGINS=https://daily-rainfall-forecasting-system.22520630.workers.dev

# Optional runtime mode overrides (keep local in serving image)
SERVING_MODEL_SOURCE=local
WEATHER_DB_BACKEND=local
